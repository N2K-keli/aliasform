# Runtime mode. Keep "production" on the server.
NODE_ENV=production
# Address and port the app listens on (Nginx proxies to it).
HOST=0.0.0.0
PORT=3000

# URL prefixes (leading slash, no trailing slash). Changing them moves every route.
PUBLIC_PATH=/collect
ADMIN_PATH=/adminView

# Dashboard login (HTTP Basic Auth). ADMIN_PASSWORD is required; the app refuses
# to start if it is empty, or "change-me" when NODE_ENV=production.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Where the database (app.db), audio files (audio/) and backups (backups/) live.
# Docker Compose overrides this with /app/data.
DATA_DIR=./data

# Recording auto-stops after this many seconds.
MAX_AUDIO_SECONDS=60
# Maximum upload size of one recording, in megabytes.
MAX_AUDIO_MB=10
# Maximum length of a written translation.
MAX_TEXT_CHARS=500

# The app runs behind Nginx: trust X-Forwarded-For for client IPs.
TRUST_PROXY=true
# Rate limits per client IP.
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_UPLOADS_PER_HOUR=600

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
