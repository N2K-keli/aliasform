{
  "name": "aila-collector",
  "version": "1.0.0",
  "private": true,
  "description": "AILA School voice and translation collector",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "build:css": "tailwindcss -i src/styles/input.css -o public/assets/app.css --minify",
    "dev:css": "tailwindcss -i src/styles/input.css -o public/assets/app.css --watch",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
